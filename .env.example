# Clerk (pull real values with `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/play
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/play

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Written by `npx convex dev` alongside the two above. No app code reads it today
# (Clerk is the auth provider, so nothing calls the Convex HTTP/site origin); kept
# because the CLI rewrites the line on every run anyway.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Vercel / AI Gateway (written by `vercel env pull`; used by Eve + AI SDK)
VERCEL_OIDC_TOKEN=
# AI_GATEWAY_API_KEY=   # alternative to OIDC when running outside Vercel

# Convex deployment env (set with `npx convex env set`, NOT in this file):
#   CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-frontend-api-domain>

# Eve agent (server-to-server auth for /api/ai/*  ->  agent/channels/eve.ts)
EVE_SERVER_SECRET=
# EVE_HOST=http://localhost:3000        # optional override; defaults to VERCEL_URL / localhost:3000

# End-to-end tests (Playwright + @clerk/testing). See README -> "End-to-end tests".
# Point the suite at an already-running server; unset or empty means it starts `pnpm dev` itself.
E2E_BASE_URL=
# Credentials for a throwaway user on the Clerk DEVELOPMENT instance. Both must be set
# or e2e/auth.spec.ts skips itself and no Clerk testing token is requested.
# Preferred: the test user's email — the suite mints a sign-in token for it (bypasses device trust).
E2E_CLERK_USER_EMAIL=
# Fallback: username + password (fails with needs_client_trust when device trust is on).
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
